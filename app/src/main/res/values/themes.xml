<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GCalSearchAdd" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/bg_deep</item>
        <item name="colorPrimaryDark">@color/bg_deep</item>
        <item name="colorAccent">@color/neon_cyan</item>
        <item name="android:windowBackground">@color/bg_deep</item>
        <item name="android:statusBarColor">@color/bg_deep</item>
        <item name="android:navigationBarColor">@color/bg_deep</item>
    </style>

    <!-- עיצוב כהה לבורר תאריך/שעה, כדי שיתאים לשאר האפליקציה ושהכפתורים יהיו קריאים -->
    <style name="NeonPickerDialog" parent="Theme.MaterialComponents.Dialog.Alert">
        <item name="colorPrimary">@color/neon_cyan</item>
        <item name="colorAccent">@color/neon_cyan</item>
        <item name="colorControlActivated">@color/neon_cyan</item>
        <item name="android:colorBackground">@color/surface</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/NeonPickerButton</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/NeonPickerButton</item>
    </style>

    <style name="NeonPickerButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/neon_cyan</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- עיצוב אמיתי, לא תלוי-יצרן, לבורר תאריך/שעה - זהה בכל מכשיר -->
    <style name="ThemeOverlay.App.DatePicker" parent="ThemeOverlay.MaterialComponents.MaterialCalendar">
        <item name="colorPrimary">@color/neon_cyan</item>
        <item name="colorOnPrimary">@color/bg_deep</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:colorBackground">@color/bg_deep</item>
    </style>

    <style name="ThemeOverlay.App.TimePicker" parent="ThemeOverlay.MaterialComponents.TimePicker">
        <item name="colorPrimary">@color/neon_cyan</item>
        <item name="colorOnPrimary">@color/bg_deep</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:colorBackground">@color/bg_deep</item>
    </style>
</resources>
