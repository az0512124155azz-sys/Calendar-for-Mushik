<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_deep"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/add_event_title"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/neon_cyan"
        android:letterSpacing="0.03"
        android:layout_marginBottom="20dp" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:boxCornerRadiusTopStart="14dp"
        app:boxCornerRadiusTopEnd="14dp"
        app:boxCornerRadiusBottomStart="14dp"
        app:boxCornerRadiusBottomEnd="14dp"
        app:boxBackgroundColor="@color/surface"
        app:boxStrokeColor="@color/neon_cyan"
        app:hintTextColor="@color/text_secondary"
        android:textColorHint="@color/text_secondary"
        android:hint="@string/event_title_hint">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/tvDatePicker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:padding="14dp"
        android:background="@drawable/bg_rounded_field"
        android:drawableStart="@android:drawable/ic_menu_my_calendar"
        android:drawablePadding="10dp"
        app:drawableTint="@color/neon_cyan"
        android:text="@string/event_date_hint"
        android:textColor="@color/text_primary"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvStartTimePicker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:padding="14dp"
        android:background="@drawable/bg_rounded_field"
        android:drawableStart="@android:drawable/ic_menu_recent_history"
        android:drawablePadding="10dp"
        app:drawableTint="@color/neon_lime"
        android:text="@string/event_start_hint"
        android:textColor="@color/text_primary" />

    <TextView
        android:id="@+id/tvEndTimePicker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:padding="14dp"
        android:background="@drawable/bg_rounded_field"
        android:drawableStart="@android:drawable/ic_menu_recent_history"
        android:drawablePadding="10dp"
        app:drawableTint="@color/neon_magenta"
        android:text="@string/event_end_hint"
        android:textColor="@color/text_primary" />

    <TextView
        android:id="@+id/tvExistingEventsLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="@string/existing_events_label"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:letterSpacing="0.03"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/progressExistingEvents"
        style="?android:attr/progressBarStyleSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="@color/neon_cyan"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvExistingEvents"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:layout_marginTop="4dp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        android:gravity="end">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:text="@string/cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            app:cornerRadius="8dp"
            android:backgroundTint="@color/pastel_blue"
            android:textColor="@color/bg_deep"
            android:text="@string/save" />

    </LinearLayout>

</LinearLayout>
